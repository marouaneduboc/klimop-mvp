    {
      "id": "s07_koningsdag",
      "level": "A2",
      "theme": "culture",
      "title": "Koningsdag",
      "titleEn": "King's Day",
      "lines": [
        "Op Koningsdag viert Nederland de verjaardag van de koning.",
        "Mensen verkopen spullen op de vrijmarkt.",
        "De straten zijn oranje en vol muziek.",
        "Nora verkoopt oude boeken en speelgoed.",
        "Aan het eind van de dag is ze moe, maar gelukkig."
      ],
      "glossary": [
        {
          "nl": "vrijmarkt",
          "en": "free market / flea market"
        },
        {
          "nl": "spullen",
          "en": "stuff / things"
        },
        {
          "nl": "koning",
          "en": "king"
        }
      ],
      "questions": [
        {
          "q": "Wat viert Nederland op Koningsdag?",
          "options": [
            "de verjaardag van de koning",
            "Kerst",
            "Pasen"
          ],
          "correct": "de verjaardag van de koning"
        },
        {
          "q": "Wat verkoopt Nora?",
          "options": [
            "boeken en speelgoed",
            "fietsen",
            "kaas"
          ],
          "correct": "boeken en speelgoed"
        }
      ]
    },
    {
      "id": "s08_polder",
      "level": "A2",
      "theme": "culture",
      "title": "In de polder",
      "titleEn": "In the polder",
      "lines": [
        "Nederland heeft veel polders: land onder zeeniveau.",
        "Een molen hielp vroeger water weg te pompen.",
        "Nu doen pompen dat werk vaak.",
        "Lotte fietst langs een dijk.",
        "Ze ziet koeien, water en een oude molen."
      ],
      "glossary": [
