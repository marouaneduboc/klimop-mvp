    {
      "id": "s01_markt",
      "level": "A0",
      "theme": "culture",
      "title": "Op de markt",
      "titleEn": "At the market",
      "lines": [
        "Het is zaterdag.",
        "Lisa gaat naar de markt.",
        "Ze koopt verse kaas en bloemen.",
        "De verkoper zegt: \"Dank je wel!\"",
        "Lisa is blij. Gezellig!"
      ],
      "glossary": [
        {
          "nl": "markt",
          "en": "market"
        },
        {
          "nl": "kaas",
          "en": "cheese"
        },
        {
          "nl": "bloemen",
          "en": "flowers"
        }
      ],
      "questions": [
        {
          "q": "Welke dag is het?",
          "options": [
            "zaterdag",
            "maandag",
            "vrijdag"
          ],
          "correct": "zaterdag"
        },
        {
          "q": "Wat koopt Lisa?",
          "options": [
            "kaas en bloemen",
            "brood en melk",
            "fietsen"
          ],
          "correct": "kaas en bloemen"
        }
      ]
    },
    {
