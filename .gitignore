!apps/web/public/audio/listen/*.mp3
assets_raw/audio/
*.mp3
!apps/web/public/audio/listen/*.mp3
*.wav
*.m4a

# Temp asset conversion workspace
apps/web/public/_asset_work/
*.tsbuildinfo

# Local sync DB
apps/api/data/
apps/api/__api.log
apps/web/__web.log

# Local TLS (mkcert) — never commit keys
